%%{init: {"theme":"base","themeVariables":{"primaryColor":"#e3f0fb","primaryBorderColor":"#2f7fb8","lineColor":"#6b7280","primaryTextColor":"#1a1a1a"}} }%%
classDiagram
    direction TB

    class LlmClient {
        -provider : GeminiProvider
        +complete(LlmRequest) LlmResponse
        -checkInputBudget(LlmRequest) void
    }

    class GeminiProvider {
        -apiKey : string
        -model : string
        +complete(LlmRequest) LlmResponse
        -parseRetryDelay(error) int
    }

    class GeminiEmbedder {
        -apiKey : string
        -model : string
        -dimensions : int
        +embedMany(texts) number[][]
    }

    class QuotaBudget {
        -requestsPerMinute : int
        -tokensPerMinute : int
        -requestsPerDay : int
        -headroom : number
        +tryReserve(QuotaCost) ReserveResult
        +settle(Reservation, actual) void
        +release(Reservation) void
    }

    class ReviewPlanner {
        +planLlmReview(files, limits) LlmReviewPlan
    }

    class LlmRequest {
        +systemPrompt : string
        +diffHunks : string
        +maxOutputTokens : int
        +temperature : number
    }

    class LlmResponse {
        +text : string
        +provider : string
        +model : string
        +promptTokens : int
        +completionTokens : int
    }

    LlmClient *-- GeminiProvider
    LlmClient ..> LlmRequest
    LlmClient ..> LlmResponse
    ReviewPlanner ..> QuotaBudget : estimated cost
    LlmResponse ..> QuotaBudget : settles with token counts
    GeminiEmbedder ..> QuotaBudget : embedding quota

    note for LlmClient "Gemini is the only provider, no fallback chain.<br/>Separate dev and prod API keys (NFR-11, NFR-14).<br/>Over-budget input: file skipped, never split."
    note for QuotaBudget "Reserved by the orchestrator before fan-out,<br/>so production never receives a 429.<br/>Daily window resets at midnight Pacific."
