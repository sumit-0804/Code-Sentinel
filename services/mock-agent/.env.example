# Which agent this instance pretends to be.
MOCK_AGENT_KIND=security

# Port to listen on. Defaults to the agent kind's port from plans/README.md
# (security 8081, style 8082, performance 8083, logic 8084, documentation 8085).
PORT=8081

# Artificial delay before responding, in milliseconds. Useful for exercising the
# orchestrator's per-agent timeout (FR-ORC-02).
MOCK_DELAY_MS=0

# Simulate a failure mode: 500 | timeout | malformed. Leave unset for normal operation.
MOCK_FAIL=

# Path to a JSON file of findings to return instead of the built-in fixture for this
# agent kind (services/mock-agent/fixtures/*.json).
MOCK_FINDINGS_FILE=
